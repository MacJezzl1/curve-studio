{
  "name": "curve-studio-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Curve Studio: Toolkit for Meteora Dynamic Bonding Curves (DBC), DAMM v2, and DLMM",
  "scripts": {
    "build": "turbo run build --filter=@curve-studio/web",
    "build:all": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "3.2.7",
    "fast-check": "^4.10.2",
    "next": "14.2.23",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dlmm": "1.9.14",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.98.0",
    "bn.js": "5.2.1",
    "decimal.js": "10.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@stellar/stellar-sdk",
      "bigint-buffer",
      "blake-hash",
      "bufferutil",
      "esbuild",
      "protobufjs",
      "tiny-secp256k1",
      "usb",
      "utf-8-validate"
    ]
  }
}
