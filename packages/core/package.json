  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bn.js": "^5.2.1",
    "decimal.js": "^10.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.13.9",
    "fast-check": "^3.23.2",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
