{
  "name": "@curve-studio/core",
  "version": "0.1.0",
  "description": "Pure mathematical core for Meteora Dynamic Bonding Curves: builder, validator, curve math, simulator, and metrics",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
